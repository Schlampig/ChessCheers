# ============================================================
# ChessCheers .gitignore
# 只把「网站运行必需的内容」与对外文档提交到仓库
# ============================================================

# ---------- 系统文件 ----------
.DS_Store
._*
Thumbs.db
desktop.ini

# ---------- AI 编码助手 / 编辑器本地配置 ----------
.claude/
.workbuddy/
.cursor/
.vscode/
.idea/
*.code-workspace

# ---------- 依赖 ----------
node_modules/
__pycache__/
package-lock.json

# ---------- 内部开发资料 ----------
# 开发进度日志：逐阶段实现细节与排错过程
dev_log.txt

# 素材瘦身前的原始文件备份（体积大，不参与发布）
.assets-original/

# 设计过程草稿（roadmap、方案迭代稿、AI 对话整理、设计过程 docx/pdf）
doc/idea/

# Office 临时锁文件
doc/~$*

# ---------- 开发期工具（不影响网站运行）----------
# 引擎探针：验证 stockfish.wasm 能否在浏览器外跑起来
code/test/engine-probe/

# ---------- 本地日志与临时文件 ----------
*.log
*.tmp
/tmp/
